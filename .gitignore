# ============================================================
# Root level — only game/ and project essentials are tracked
# ============================================================
/*
!/game/
!/.gitignore

# ============================================================
# Ren'Py runtime / generated files
# ============================================================

# Player save data
/game/saves/

# Compiled script and module cache
/game/cache/
/game/**/*.rpyc
/game/**/*.rpymc

# Ren'Py backup/temp files
/game/**/*.bak
/game/**/*.new
/game/**/*.old

# Ren'Py engine libraries (large binaries, not game content)
/game/libs/

# Auto-generated translation stubs
/game/tl/

# ============================================================
# Design / planning documents (not game content)
# ============================================================
/game/**/*.docx
/game/**/*.pdf

# ============================================================
# Sample / placeholder assets
# ============================================================
/game/images/GALLERY SAMPLE/
/game/images/GALLERY_SAMPLE/

# ============================================================
# Editor and OS files
# ============================================================
.DS_Store
/game/.vscode/
